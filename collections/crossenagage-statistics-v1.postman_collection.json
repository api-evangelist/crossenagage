        {
          "id": "48a82205-7bdf-4736-8712-e2ba00f60d3b",
          "name": "Get detailed statistics",
          "request": {
            "name": "Get detailed statistics",
            "description": {
              "content": "Use this endpoint to get statistics for certain entity IDs (story, campaign or message ID)\non your account according to a variety of aggregation options.\n\nPlease note that, according to the time interval you request in conjunction with the aggregation, our system will expand your requested interval to fit as many aggregations as possible. Please see the examples below:\n\n> Requesting an interval from `2018-08-24T00:00:00Z` to `2018-08-26T23:59:59Z` with a `MONTH` aggregation would return data from `2018-08-01T00:00:00Z` to `2018-08-31T23:59:59Z` (returning the entire month of August 2018).\n\n> Requesting an interval from `2018-08-24T00:00:00Z` to `2018-08-31T23:59:59Z` with a `WEEK` aggregation would return data from `2018-08-20T00:00:00Z` to `2018-09-02T23:59:59Z` (returning calendar Week 34 and 35 of 2018).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "detailed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "e.g. 2",
                "key": "X-XNG-ApiVersion",
                "value": "<string>"
              },
              {
                "disabled": false,
